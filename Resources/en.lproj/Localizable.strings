/* BossSDD interface strings — base language.
   Keys are namespaced rather than English prose so that two controls that happen
   to share an English word can still diverge in another language. Counted strings
   whose noun has to agree live in Localizable.stringsdict instead. */

/* Task state, shown on a card, a pill and the floating tally. The card gives these
   about 90pt, so they have to stay one short word where the Chinese is one word. */
"state.waiting" = "Waiting";
"state.ready" = "Ready";
"state.running" = "Running";
"state.review" = "Review";
"state.blocked" = "Blocked";
"state.done" = "Done";
"state.resourceHeld" = "Resource held";

/* Run status. Separate from task state: a run is "in review" as a whole, a task is
   waiting for one reviewer. */
"run.status.pending" = "Not started";
"run.status.planning" = "Planning";
"run.status.awaitingConfirmation" = "Needs approval";
"run.status.running" = "Running";
"run.status.review" = "In review";
"run.status.blocked" = "Blocked";
"run.status.done" = "Done";

/* Toolbar view switcher — three segments sharing 210pt. */
"board.view.graph" = "Graph";
"board.view.columns" = "Columns";
"board.view.memory" = "Memory";

/* Write API status. */
"server.stopped" = "Server stopped";
/* The port is an identifier, not a quantity: %@ so it never picks up the
   locale's digit grouping and comes out as "Port 18,991". */
"server.badge.port" = "Port %@";
"server.badge.port.help" = "The write API is not on the default port, so callers have to name it.";
"server.badge.down" = "API not running";
"server.badge.down.help" = "Agents cannot write to the board right now.";
"server.badge.failed.help" = "The write API failed to start.";

/* Legacy JSON import and the login item. */
"import.skipped" = "Skipped %1$lld: %2$@";
"import.skipped.separator" = "; ";
"login.failed" = "Could not change the login item: %@";

/* Startup. */
"app.starting" = "Starting…";
"app.startFailed" = "The board could not start";


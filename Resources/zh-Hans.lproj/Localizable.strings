"memory.kind.hardRule" = "硬规则";
"memory.kind.exclusiveResource" = "独占资源";
"memory.kind.note" = "备注";
/* **…** 表示强调（Markdown）。被标出的片段与相邻标点之间要隔开：标点紧贴 ** 时解析会失败。 */
"memory.note" = "**这份记忆属于项目，不属于这次运行**。同一个仓库的每一次运行、以及它的每一个 worktree，读写的都是这一份。每条都必须带**出处**——这是让人一次文件读取就能证伪它的把手，也是它和「凭印象记下来的事」唯一的区别。";
"memory.empty" = "这个项目还没有记忆。第一次运行的 recon 会把门禁、启动配方和硬规则写进来。";
"memory.noProject.detail" = "记忆按仓库存放。创建运行时带上项目路径，这里才会显示它的记忆。";
"memory.tally.source" = "每条都带出处";
"memory.tally.grouped" = "按类型分组，无搜索";

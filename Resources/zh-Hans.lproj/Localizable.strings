"memory.cap.pill" = "%1$lld / %2$lld 条";
"memory.updated" = "更新于 %@";
/* %1$@ 仓库，%2$lld 条数，%3$lld 上限，%4$@ 类数（"memory.kinds"）。第二种用于运行自己的
   项目路径被解析成另一个仓库的情形。 */
"memory.subtitle" = "%1$@ · 项目记忆 %2$lld/%3$lld · %4$@";
"memory.subtitle.resolved" = "%1$@（由运行的路径解析而来）· 项目记忆 %2$lld/%3$lld · %4$@";

